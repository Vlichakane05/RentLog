@using RentLog.Services

@*
MediaGallery component: displays photos and videos in a responsive grid.
Supports full-screen viewer for photos and player for videos.
Shows alt text and supports keyboard navigation.
*@

<div class="media-gallery @CssClass">
	@if (MediaItems.Count == 0)
	{
		<div class="gallery-empty">
			<span class="gallery-empty-icon">📷</span>
			<span class="gallery-empty-text">No media to display</span>
		</div>
	}
	else
	{
		<!-- Thumbnail grid -->
		<div class="gallery-grid">
			@foreach (var media in MediaItems)
			{
				<div class="gallery-item" key="@media.Id">
					<button
						type="button"
						class="gallery-thumbnail"
						@onclick="() => ViewMedia(media)"
						title="@media.AltText"
						aria-label="View @media.AltText">

						@if (media.MimeType.StartsWith("image"))
						{
							<img
								src="@media.ThumbnailBase64"
								alt="@media.AltText"
								class="thumbnail-image"
								loading="lazy" />
						}
						else if (media.MimeType.StartsWith("video"))
						{
							<div class="thumbnail-video-overlay">
								<span class="video-play-icon">▶</span>
								@if (media.DurationSeconds.HasValue)
								{
									<span class="video-duration">@FormatDuration(media.DurationSeconds.Value)</span>
								}
							</div>
						}
					</button>

					@if (!string.IsNullOrEmpty(media.AltText))
					{
						<div class="gallery-alt-text">
							<span class="alt-label">Alt:</span>
							<span class="alt-value">@media.AltText</span>
						</div>
					}
				</div>
			}
		</div>
	}
</div>

<!-- Full-screen viewer/player modal -->
@if (CurrentViewingMedia != null)
{
	<div class="gallery-viewer-backdrop" @onclick="CloseViewer" role="presentation"></div>
	<dialog class="gallery-viewer" open>
		<!-- Close button -->
		<button
			type="button"
			class="viewer-close"
			@onclick="CloseViewer"
			aria-label="Close viewer">
			✕
		</button>

		<!-- Previous/Next navigation -->
		@if (MediaItems.Count > 1)
		{
			<button
				type="button"
				class="viewer-nav viewer-prev"
				@onclick="PreviousMedia"
				aria-label="Previous media">
				‹
			</button>
			<button
				type="button"
				class="viewer-nav viewer-next"
				@onclick="NextMedia"
				aria-label="Next media">
				›
			</button>
		}

		<!-- Viewer content -->
		<div class="viewer-content">
			@if (CurrentViewingMedia.MimeType.StartsWith("image"))
			{
				<img
					src="@CurrentViewingMedia.Base64Data"
					alt="@CurrentViewingMedia.AltText"
					class="viewer-image" />
			}
			else if (CurrentViewingMedia.MimeType.StartsWith("video"))
			{
				<video class="viewer-video" controls>
					<source src="@CurrentViewingMedia.Base64Data" type="@CurrentViewingMedia.MimeType" />
					Your browser does not support the video tag.
				</video>
			}
		</div>

		<!-- Media info -->
		<div class="viewer-info">
			<div class="viewer-title">@CurrentViewingMedia.AltText</div>
			@if (!string.IsNullOrEmpty(CurrentViewingMedia.AltText))
			{
				<div class="viewer-description">@CurrentViewingMedia.AltText</div>
			}
			<div class="viewer-meta">
				@if (CurrentViewingMedia.MimeType.StartsWith("video") && CurrentViewingMedia.DurationSeconds.HasValue)
				{
					<span class="meta-item">Duration: @FormatDuration(CurrentViewingMedia.DurationSeconds.Value)</span>
				}
				<span class="meta-item">@(MediaItems.IndexOf(CurrentViewingMedia) + 1) / @MediaItems.Count</span>
			</div>
		</div>
	</dialog>
}

@code {
	/// <summary>
	/// List of media files to display.
	/// </summary>
	[Parameter]
	public List<MediaFile> MediaItems { get; set; } = new();

	/// <summary>
	/// Callback when a media item is selected for viewing.
	/// </summary>
	[Parameter]
	public EventCallback<MediaFile> OnMediaSelected { get; set; }

	/// <summary>
	/// Additional CSS classes.
	/// </summary>
	[Parameter]
	public string CssClass { get; set; } = string.Empty;

	private MediaFile? CurrentViewingMedia { get; set; }

	private void ViewMedia(MediaFile media)
	{
		CurrentViewingMedia = media;
		OnMediaSelected.InvokeAsync(media);
	}

	private void NextMedia()
	{
		if (CurrentViewingMedia == null || MediaItems.Count == 0)
			return;

		var currentIndex = MediaItems.IndexOf(CurrentViewingMedia);
		var nextIndex = (currentIndex + 1) % MediaItems.Count;
		CurrentViewingMedia = MediaItems[nextIndex];
	}

	private void PreviousMedia()
	{
		if (CurrentViewingMedia == null || MediaItems.Count == 0)
			return;

		var currentIndex = MediaItems.IndexOf(CurrentViewingMedia);
		var prevIndex = currentIndex == 0 ? MediaItems.Count - 1 : currentIndex - 1;
		CurrentViewingMedia = MediaItems[prevIndex];
	}

	private void CloseViewer()
	{
		CurrentViewingMedia = null;
	}

	private string FormatDuration(double seconds)
	{
		var minutes = (int)(seconds / 60);
		var secs = (int)(seconds % 60);
		return $"{minutes:D1}:{secs:D2}";
	}
}
