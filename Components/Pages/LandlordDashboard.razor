                    </div>
                </div>
            }

            <!-- TAB 4: INVOICES & PROOF MEDIA -->
            @if (_activeTab == "INVOICES")
            {
                <div class="space-y-6">
                    <div>
                        <h2 class="text-base font-bold text-white">Contractor Invoices & GPS Proof Media</h2>
                        <p class="text-xs text-slate-400">Review completed job photos with geo-location tags before authorizing payout</p>
                    </div>

                    <!-- Invoices List -->
                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var invoice in _invoices)
                        {
                            var contractor = _contractors.FirstOrDefault(c => c.Id == invoice.ContractorId);
                            var mediaItems = _proofMedia.Where(p => p.WorkOrderId == invoice.WorkOrderId).ToList();

                            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
                                    <div>
                                        <div class="flex items-center space-x-2">
                                            <span class="font-mono text-xs font-bold text-amber-400">@invoice.InvoiceNumber</span>
                                            <span class="text-xs text-slate-500">&bull;</span>
                                            <span class="text-xs text-slate-300 font-medium">@(contractor?.CompanyName ?? "Contractor")</span>
                                        </div>
                                        <p class="text-lg font-black text-white mt-1">Total Due: R @invoice.TotalAmount.ToString("N2")</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        @if (invoice.IsApprovedByLandlord)
                                        {
                                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center space-x-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                                <span>Invoice Approved &bull; @invoice.PayoutStatus</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="@(() => ApproveInvoiceAsync(invoice.Id, true))"
                                                    class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow shadow-emerald-600/30 flex items-center space-x-1.5">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                                <span>Approve & Authorize Payout</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- Field Proof Media with GPS Lat / Long -->
                                <div class="space-y-2">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Attached Field Proof Media</h4>
                                    @if (!mediaItems.Any())
                                    {
                                        <p class="text-xs text-slate-500 italic">No job proof media uploaded yet for this work order.</p>
                                    }
                                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                                        @foreach (var media in mediaItems)
                                        {
                                            <div class="bg-slate-950/60 rounded-xl overflow-hidden border border-slate-800">
                                                <img src="@media.MediaUrl" alt="@media.ProofType" class="w-full h-36 object-cover" />
                                                <div class="p-3 space-y-1 text-xs">
                                                    <div class="flex items-center justify-between">
                                                        <span class="font-bold text-slate-200 uppercase tracking-wider text-[10px]">@media.ProofType</span>
                                                        <span class="text-[10px] text-slate-400">@media.CreatedAt.ToString("HH:mm, dd MMM")</span>
                                                    </div>
                                                    @if (media.Latitude.HasValue && media.Longitude.HasValue)
                                                    {
                                                        <div class="flex items-center space-x-1 text-[11px] text-emerald-400 font-mono">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                                                            <span>GPS: @media.Latitude.Value.ToString("F4"), @media.Longitude.Value.ToString("F4")</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </main>
    }

