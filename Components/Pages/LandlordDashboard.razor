    private bool _showInviteModal;
    private bool _isSendingInvite;
    private string? _inviteError;
    private string? _inviteSuccess;
    private InviteTenantViewModel _inviteModel = new();

    private bool _showAddContractorModal;
    private bool _isSavingContractor;
    private string? _contractorModalError;
