    private async Task HandleAddContractorAsync()
    {
        _contractorModalError = null;
        _isSavingContractor = true;

        try
        {
            var user = new UserEntity
            {
                Id = Guid.NewGuid(),
                FullName = _contractorModel.FullName.Trim(),
                Email = _contractorModel.Email.Trim().ToLowerInvariant(),
                PhoneNumber = _contractorModel.PhoneNumber?.Trim(),
                Role = "CONTRACTOR",
                CreatedAt = DateTime.UtcNow
            };

            var profile = new ContractorProfileEntity
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                CompanyName = _contractorModel.CompanyName.Trim(),
                Trade = _contractorModel.Trade,
                TaxVatNumber = _contractorModel.TaxVatNumber?.Trim(),
                BankAccountDetails = !string.IsNullOrWhiteSpace(_contractorModel.BankAccountDetails) ? _contractorModel.BankAccountDetails : "{}",
                IsVerified = _contractorModel.IsVerified,
                AverageRating = 5.0m,
                CreatedAt = DateTime.UtcNow
            };

            await PropertyService.RegisterContractorProfileAsync(user, profile);
            _showAddContractorModal = false;
            await LoadLandlordDataAsync();
        }
        catch (Exception ex)
        {
            _contractorModalError = ex.Message;
        }
        finally
        {
            _isSavingContractor = false;
        }
    }

    private void OpenAssignContractorModal(WorkOrderEntity wo)
    {
        _selectedWorkOrder = wo;
        _showAssignModal = true;
    }

    private async Task AssignContractorToWorkOrderAsync(Guid contractorId)
    {
        if (_selectedWorkOrder == null) return;
        var wo = await PropertyService.AssignContractorAsync(_selectedWorkOrder.Id, contractorId);
        _showAssignModal = false;

        var contractor = _contractors.FirstOrDefault(c => c.Id == contractorId);
        var contractorName = contractor?.CompanyName ?? "Contractor";
        
        // Build the special direct contractor portal link for this specific work order
        // Include pin query parameter so opening the link can automatically authorize
        var pinCode = wo.Id.ToString("N")[..4].ToUpperInvariant();
        var directLink = $"{Navigation.BaseUri.TrimEnd('/')}/contractor/job/{wo.Id}?pin={pinCode}";
        _lastDispatchedLink = directLink;

        // Lookup contractor email and address
        var destEmail = _usersById.TryGetValue(contractor?.UserId ?? Guid.Empty, out var u) ? u.Email : null;
        if (string.IsNullOrWhiteSpace(destEmail) && contractor != null)
        {
            var userFromDb = await PropertyService.GetUserByIdAsync(contractor.UserId);
            if (userFromDb != null) destEmail = userFromDb.Email;
        }

        var unit = _units.FirstOrDefault(un => un.Id == wo.UnitId);
        var unitAddress = unit != null ? $"{unit.BuildingName} - Unit {unit.UnitNumber}, {unit.StreetAddress}" : "Unit property address";

        bool emailSent = false;
        if (!string.IsNullOrWhiteSpace(destEmail))
        {
            emailSent = await EmailService.SendContractorJobNotificationAsync(
                destEmail,
                contractorName,
                wo.Title,
                wo.Priority,
                unitAddress,
                directLink,
                pinCode);
        }

        _dispatchNotification = emailSent
            ? $"Real email dispatched to {contractorName} ({destEmail}) with PIN: {pinCode} and portal link!"
            : $"Notification ready for {contractorName} ({destEmail ?? "Tech"}). Link: {directLink} (PIN: {pinCode})";

        await LoadLandlordDataAsync();
    }

