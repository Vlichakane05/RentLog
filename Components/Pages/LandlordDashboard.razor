                                        {
                                            <div class="p-3 bg-slate-800/40 rounded-xl border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                                                <div>
                                                    <div class="flex items-center space-x-2">
                                                        <span class="font-bold text-white">Labor: R @quote.LaborCost.ToString("N2")</span>
                                                        <span class="text-slate-500">+</span>
                                                        <span class="font-bold text-white">Materials: R @quote.MaterialCost.ToString("N2")</span>
                                                        <span class="text-slate-500">=</span>
                                                        <span class="text-sm font-black text-indigo-400">Total: R @quote.TotalAmount.ToString("N2")</span>
                                                    </div>
                                                    <p class="text-[11px] text-slate-400 mt-1 italic">"@quote.Notes" (Est: @(quote.EstimatedHours ?? 0) hrs)</p>
                                                </div>
                                                <div class="flex items-center space-x-2">
                                                    @if (quote.Status == "APPROVED")
                                                    {
                                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Quote Approved</span>
                                                    }
                                                    else if (quote.Status == "REJECTED")
                                                    {
                                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">Quote Rejected</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" @onclick="@(() => UpdateQuoteStatusAsync(quote.Id, "APPROVED"))"
                                                                class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors shadow">
                                                            Approve Quote
                                                        </button>
                                                        <button type="button" @onclick="@(() => UpdateQuoteStatusAsync(quote.Id, "REJECTED"))"
                                                                class="px-3 py-1.5 rounded-lg bg-rose-600/30 hover:bg-rose-600/50 text-rose-300 font-bold text-xs border border-rose-500/30 transition-colors">
                                                            Reject
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
