    private string? _dispatchNotification;
    private string? _lastDispatchedLink;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
        await LoadLandlordDataAsync();
    }

    private async Task LoadLandlordDataAsync()
    {
        _isLoading = true;
        try
        {
            var landlordId = _currentUser != null && Guid.TryParse(_currentUser.Id, out var id)
                ? id
                : MockPropertyManagementService.DemoLandlordId;

            _units = (await PropertyService.GetUnitsAsync(landlordId)).ToList();
            _tenancies = (await PropertyService.GetTenanciesAsync(landlordId)).ToList();
            _invites = (await PropertyService.GetInvitesForLandlordAsync(landlordId)).ToList();
            _payments = (await PropertyService.GetAllPaymentsAsync(landlordId)).ToList();
            _workOrders = (await PropertyService.GetWorkOrdersForLandlordAsync(landlordId)).ToList();
            _quotes = (await PropertyService.GetAllQuotesAsync()).ToList();
            _contractors = (await PropertyService.GetContractorProfilesAsync()).ToList();
            _invoices = (await PropertyService.GetAllInvoicesAsync(landlordId)).ToList();

            // Load all co-tenants and tenant profiles
            _coTenants.Clear();
            _usersById.Clear();
            foreach (var t in _tenancies)
            {
                var cts = await PropertyService.GetCoTenantsAsync(t.Id);
                _coTenants.AddRange(cts);
                await CacheUserAsync(t.PrimaryTenantId);
                foreach (var co in cts)
                    await CacheUserAsync(co.TenantId);
            }

            // Load proof media for work orders
            _proofMedia.Clear();
            foreach (var wo in _workOrders)
            {
                var media = await PropertyService.GetProofMediaForWorkOrderAsync(wo.Id);
                _proofMedia.AddRange(media);
            }

            _totalRevenue = _payments.Where(p => p.Status == "PAID").Sum(p => p.Amount);
            _totalContractorInvoices = _invoices.Sum(i => i.TotalAmount);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CacheUserAsync(Guid userId)
    {
        if (userId == Guid.Empty || _usersById.ContainsKey(userId))
            return;
        var user = await PropertyService.GetUserByIdAsync(userId);
        if (user != null)
            _usersById[userId] = user;
    }

    private string GetUserName(Guid userId) =>
        _usersById.TryGetValue(userId, out var user) ? user.FullName : "Assigned tenant";

    private void OpenInviteModal(Guid? unitId)
    {
        _inviteError = null;
        _inviteSuccess = null;
        _inviteModel = new InviteTenantViewModel
        {
            UnitId = unitId ?? _units.FirstOrDefault()?.Id ?? Guid.Empty,
            TenantEmail = string.Empty,
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddYears(1)
        };
        _showInviteModal = true;
    }

    private async Task HandleSendInviteAsync()
    {
        _inviteError = null;
        _inviteSuccess = null;
        _isSendingInvite = true;
        try
        {
            var landlordId = _currentUser != null && Guid.TryParse(_currentUser.Id, out var id)
                ? id
                : MockPropertyManagementService.DemoLandlordId;

            await PropertyService.InviteTenantToUnitAsync(
                landlordId,
                _inviteModel.UnitId,
                _inviteModel.TenantEmail,
                _inviteModel.StartDate,
                _inviteModel.EndDate);

            _inviteSuccess = $"Invite sent to {_inviteModel.TenantEmail.Trim()}.";
            _showInviteModal = false;
            await LoadLandlordDataAsync();
        }
        catch (Exception ex)
        {
            _inviteError = ex.Message;
        }
        finally
        {
            _isSendingInvite = false;
        }
    }

