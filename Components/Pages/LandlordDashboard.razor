@page "/landlord"
@using System.Security.Claims
@using RentLog.Models
@using RentLog.Models.Entities
@inject IPropertyManagementService PropertyService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IEmailNotificationService EmailService
@inject RentLogAuthStateProvider AuthStateProvider

<PageTitle>Landlord Portal - RentLog</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 font-sans pb-16">
    @Header

    @if (_isLoading)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col items-center justify-center">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-500 border-t-transparent mb-4"></div>
            <p class="text-sm text-slate-400">Loading portfolio financials and property records...</p>
        </div>
    }
    else
    {
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
            <!-- Financial & Portfolio KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs font-medium uppercase tracking-wider">Total Revenue</span>
                        <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-black text-white">R @_totalRevenue.ToString("N2")</p>
                    <span class="text-[11px] text-emerald-400 font-medium">@_payments.Count(p => p.Status == "PAID") verified rent payments</span>
                </div>

                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs font-medium uppercase tracking-wider">Managed Units</span>
                        <div class="h-8 w-8 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-black text-white">@_units.Count Units</p>
                    <span class="text-[11px] text-indigo-400 font-medium">@_tenancies.Count(t => t.IsActive) currently leased</span>
                </div>

                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs font-medium uppercase tracking-wider">Contractor Invoices</span>
                        <div class="h-8 w-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" /></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-black text-white">R @_totalContractorInvoices.ToString("N2")</p>
                    <span class="text-[11px] text-amber-400 font-medium">@_invoices.Count(i => !i.IsApprovedByLandlord) awaiting approval</span>
                </div>

                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs font-medium uppercase tracking-wider">Active Work Orders</span>
                        <div class="h-8 w-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-black text-white">@_workOrders.Count(w => w.Status != "COMPLETED") Jobs</p>
                    <span class="text-[11px] text-blue-400 font-medium">@_quotes.Count(q => q.Status == "SUBMITTED") quotes to review</span>
                </div>
            </div>

            <!-- Tabs -->
            <div class="flex border-b border-slate-800 space-x-2 sm:space-x-4 overflow-x-auto scrollbar-none">
                <button type="button" @onclick="@(() => _activeTab = "UNITS")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "UNITS" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    <span>Units & Tenancies</span>
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-800 text-slate-300">@_units.Count</span>
                </button>

                <button type="button" @onclick="@(() => _activeTab = "FINANCIALS")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "FINANCIALS" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Financial Ledger</span>
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-800 text-slate-300">@_payments.Count</span>
                </button>

                <button type="button" @onclick="@(() => _activeTab = "WORK_ORDERS")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "WORK_ORDERS" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /></svg>
                    <span>Work Orders & Quotes</span>
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-indigo-500/20 text-indigo-300">@_workOrders.Count</span>
                </button>

                <button type="button" @onclick="@(() => _activeTab = "INVOICES")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "INVOICES" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    <span>Invoices & GPS Proof</span>
                    @if (_invoices.Any(i => !i.IsApprovedByLandlord))
                    {
                        <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30">Action</span>
                    }
                </button>
            </div>

            

            <!-- TAB 1: UNITS & TENANCIES -->
            @if (_activeTab == "UNITS")
            {
                <div class="space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-bold text-white">Properties & Leased Units</h2>
                            <p class="text-xs text-slate-400">Configure units, invite tenants, and track active leases</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="@(() => OpenInviteModal(null))"
                                    class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-100 text-xs font-semibold border border-slate-700 transition-all flex items-center space-x-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                                <span>Invite Tenant</span>
                            </button>
                            <button type="button" @onclick="OpenAddUnitModal" 
                                    class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow transition-all flex items-center space-x-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                <span>Add Property Unit</span>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var unit in _units)
                        {
                            var activeTenancy = _tenancies.FirstOrDefault(t => t.UnitId == unit.Id && t.IsActive);
                            var coTenants = activeTenancy != null ? _coTenants.Where(c => c.TenancyId == activeTenancy.Id).ToList() : new List<TenancyCoTenantEntity>();

                            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-3">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <h3 class="text-base font-bold text-white">@unit.BuildingName &bull; @unit.UnitNumber</h3>
                                        <p class="text-xs text-slate-400">@unit.StreetAddress</p>
                                    </div>
                                    @if (activeTenancy != null)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Occupied</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400">Vacant</span>
                                    }
                                </div>

                                <div class="grid grid-cols-2 gap-2 text-xs py-2 border-y border-slate-800">
                                    <div>
                                        <span class="text-slate-500 uppercase tracking-wider text-[10px]">Monthly Rent</span>
                                        <p class="font-bold text-slate-200">R @unit.MonthlyRent.ToString("N2")</p>
                                    </div>
                                    <div>
                                        <span class="text-slate-500 uppercase tracking-wider text-[10px]">Deposit</span>
                                        <p class="font-bold text-slate-200">R @unit.DepositAmount.ToString("N2")</p>
                                    </div>
                                </div>

                                <!-- Tenancy and Co-tenants info -->
                                <div class="text-xs text-slate-400">
                                    @if (activeTenancy != null)
                                    {
                                        var primaryTenant = GetUserName(activeTenancy.PrimaryTenantId);
                                        <div class="space-y-1">
                                            <div class="flex justify-between">
                                                <span>Primary tenant:</span>
                                                <span class="text-slate-200">@primaryTenant</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span>Active Lease:</span>
                                                <span class="text-slate-200">@activeTenancy.StartDate.ToString("dd MMM yy") &ndash; @activeTenancy.EndDate.ToString("dd MMM yy")</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span>Co-Tenants:</span>
                                                <span class="text-indigo-400 font-semibold">@coTenants.Count registered (@string.Join(", ", coTenants.Select(c => $"{c.RentSharePercentage}%")))</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="italic text-slate-500">No active lease agreement</span>
                                    }
                                </div>

                                @{
                                    var unitInvites = _invites.Where(i => i.UnitId == unit.Id && i.Status == "PENDING").ToList();
                                }
                                @if (unitInvites.Count > 0)
                                {
                                    <div class="pt-2 border-t border-slate-800 space-y-1">
                                        <p class="text-[10px] uppercase tracking-wider text-amber-400 font-semibold">Pending invites</p>
                                        @foreach (var invite in unitInvites)
                                        {
                                            <p class="text-xs text-slate-300">@invite.TenantEmail</p>
                                        }
                                    </div>
                                }

                                <button type="button" @onclick="@(() => OpenInviteModal(unit.Id))"
                                        class="w-full mt-1 py-2 rounded-xl bg-indigo-600/15 hover:bg-indigo-600/25 text-indigo-300 border border-indigo-500/30 text-xs font-semibold transition-colors">
                                    Invite tenant to this unit
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- TAB 2: FINANCIALS -->
            @if (_activeTab == "FINANCIALS")
            {
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-base font-bold text-white">Rental Income & Payout Ledger</h2>
                            <p class="text-xs text-slate-400">Full payment history with status tracking and gateway reconciliation</p>
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-800/40 text-slate-400 font-semibold uppercase tracking-wider">
                                    <tr>
                                        <th class="py-3 px-4">Date</th>
                                        <th class="py-3 px-4">Description</th>
                                        <th class="py-3 px-4">Method</th>
                                        <th class="py-3 px-4">Gateway Reference</th>
                                        <th class="py-3 px-4 text-right">Amount</th>
                                        <th class="py-3 px-4 text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800">
                                    @foreach (var payment in _payments)
                                    {
                                        <tr class="hover:bg-slate-800/30 transition-colors">
                                            <td class="py-3 px-4 text-slate-400">@payment.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td class="py-3 px-4 font-medium text-slate-200">@payment.Description</td>
                                            <td class="py-3 px-4 text-slate-400">@payment.Method</td>
                                            <td class="py-3 px-4 font-mono text-slate-400">@(payment.GatewayReference ?? "-")</td>
                                            <td class="py-3 px-4 text-right font-bold text-emerald-400">+ R @payment.Amount.ToString("N2")</td>
                                            <td class="py-3 px-4 text-center">
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                                                    @payment.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 3: WORK ORDERS & QUOTES -->
            @if (_activeTab == "WORK_ORDERS")
            {
                <div class="space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-base font-bold text-white">Work Order Management & Contractor Quotes</h2>
                            <p class="text-xs text-slate-400">Assign verified contractors and review labor & material quotes</p>
                        </div>
                        <button type="button" @onclick="OpenAddContractorModal"
                                class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-colors flex items-center space-x-1.5 shadow">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                            <span>Add Verified Contractor</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(_dispatchNotification))
                    {
                        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center justify-between shadow-sm">
                            <div class="flex items-center space-x-2.5">
                                <span class="h-6 w-6 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                </span>
                                <div>
                                    <span class="font-bold">Notification Dispatched:</span> @_dispatchNotification
                                    @if (!string.IsNullOrEmpty(_lastDispatchedLink))
                                    {
                                        <div class="mt-1 flex items-center space-x-2">
                                            <span class="text-slate-400 font-mono text-[11px]">Direct Link:</span>
                                            <a href="@_lastDispatchedLink" target="_blank" class="text-indigo-400 underline font-mono text-[11px] hover:text-indigo-300">
                                                @_lastDispatchedLink
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                            <button type="button" @onclick="@(() => _dispatchNotification = null)" class="text-slate-400 hover:text-white">&times;</button>
                        </div>
                    }

                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var wo in _workOrders)
                        {
                            var unit = _units.FirstOrDefault(u => u.Id == wo.UnitId);
                            var assignedContractor = _contractors.FirstOrDefault(c => c.Id == wo.AssignedContractorId);
                            var quotes = _quotes.Where(q => q.WorkOrderId == wo.Id).ToList();

                            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
                                    <div>
                                        <div class="flex items-center space-x-2">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300">
                                                @(unit != null ? $"{unit.BuildingName} - {unit.UnitNumber}" : "Property")
                                            </span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300">
                                                @wo.Category
                                            </span>
                                            <span class="text-xs text-slate-500">&bull; Priority: <strong class="text-white">@wo.Priority</strong></span>
                                        </div>
                                        <h3 class="text-base font-bold text-white mt-1">@wo.Title</h3>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30">
                                            @wo.Status
                                        </span>
                                        <button type="button" @onclick="@(() => OpenAssignContractorModal(wo))"
                                                class="px-3 py-1 rounded-xl bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 text-xs font-semibold transition-colors">
                                            @(assignedContractor != null ? "Reassign Contractor" : "Assign Contractor")
                                        </button>
                                    </div>
                                </div>

                                <p class="text-xs text-slate-300">@wo.Description</p>

                                <!-- Attached Pictures / Evidence -->
                                @{
                                    var woProofMedia = _proofMedia.Where(p => p.WorkOrderId == wo.Id).ToList();
                                }
                                @if (woProofMedia.Any())
                                {
                                    <div class="space-y-1.5 pt-1">
                                        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Attached Photos / Evidence (@woProofMedia.Count)</span>
                                        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2">
                                            @foreach (var media in woProofMedia)
                                            {
                                                <div class="relative rounded-lg overflow-hidden border border-slate-800 aspect-video bg-slate-950/80 group">
                                                    <img src="@media.MediaUrl" alt="@media.ProofType" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                                                    <span class="absolute bottom-1 left-1 bg-black/70 px-1.5 py-0.5 rounded text-[9px] text-slate-300 font-mono">
                                                        @media.ProofType.Replace("_", " ")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (assignedContractor != null)
                                {
                                    <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-800/80 flex items-center justify-between text-xs">
                                        <div class="flex items-center space-x-2">
                                            <div class="h-7 w-7 rounded bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                            </div>
                                            <div>
                                                <span class="font-bold text-white">@assignedContractor.CompanyName</span>
                                                <span class="text-slate-500 ml-1">(@assignedContractor.Trade &bull; Rating: @assignedContractor.AverageRating ★)</span>
                                            </div>
                                        </div>
                                        <span class="font-mono text-slate-400 text-[11px]">Assigned Tech</span>
                                    </div>
                                }

                                <!-- Submitted Quotes Review -->
                                @if (quotes.Any())
                                {
