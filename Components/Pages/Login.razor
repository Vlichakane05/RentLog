@page "/login"
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject RentLogAuthStateProvider RentLogAuthStateProvider
@inject NavigationManager Navigation

@layout LoginLayout
<PageTitle>Sign In - RentLog</PageTitle>

<div class="login-page fixed inset-0 bg-slate-950 flex items-center justify-center py-3 px-4 sm:px-6 lg:px-8 relative overflow-hidden font-sans">
    <!-- Ambient glowing background -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
  

    <div class="login-card max-w-md w-full flex flex-col bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl relative z-10">
        <!-- Logo and header -->
        <div class="text-center">
            <img src="/images/rentlog-logo.png" alt="RentLog" class="login-logo mx-auto h-28 w-28 object-contain" />
            <h2 class="login-heading mt-3 text-2xl font-bold tracking-tight text-white">Welcome to RentLog</h2>
            <p class="login-subtitle mt-1 text-sm text-slate-400">
                Sign in to your Tenant or Landlord Portal
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-start space-x-2.5">
                <svg class="w-5 h-5 flex-shrink-0 text-rose-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@_errorMessage</span>
            </div>
        }

        <EditForm Model="@_model" OnValidSubmit="HandleLoginAsync" class="login-form flex flex-col gap-4">
            <DataAnnotationsValidator />

            <!-- Email Address -->
            <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">Email Address</label>
                <InputText id="email" @bind-Value="_model.Email" type="email" autocomplete="username"
                           placeholder="you@domain.com" 
                           class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors" />
                <ValidationMessage For="@(() => _model.Email)" class="text-xs text-rose-400 mt-1" />
            </div>

            <!-- Password -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Password</label>
                    <a href="/forgot-password" class="text-xs font-medium text-indigo-400 hover:text-indigo-300 transition-colors">Forgot?</a>
                </div>
                <InputText id="password" @bind-Value="_model.Password" type="password" autocomplete="current-password"
                           placeholder="••••••••" 
                           class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors" />
                <ValidationMessage For="@(() => _model.Password)" class="text-xs text-rose-400 mt-1" />
            </div>

            <!-- Submit Button -->
            <button type="submit" disabled="@_isLoading" 
                    class="w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center space-x-2 disabled:opacity-50">
                @if (_isLoading)
                {
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Verifying Credentials...</span>
                }
                else
                {
                    <span>Sign In to Portal</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                }
            </button>
        </EditForm>

        <!-- Navigation Links -->
        <div class="login-links pt-4 border-t border-slate-800 text-center space-y-2">
            <p class="text-sm text-slate-400">
                Don't have an account yet? 
                <a href="/signup" class="font-semibold text-indigo-400 hover:text-indigo-300 ml-1 transition-colors">Sign up here</a>
            </p>
            <div class="pt-2">
                <a href="/contractor/login" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs font-semibold text-amber-300 hover:bg-amber-500/20 transition-colors">
                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    <span>Contractor Temporary PIN Access &rarr;</span>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginViewModel _model = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleLoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var user = await AuthService.LoginAsync(_model.Email, _model.Password);
            if (user != null)
            {
                await RentLogAuthStateProvider.LoginAsync(user);
                var destination = user.Role switch
                {
                    UserRole.Landlord => "/landlord",
                    UserRole.Contractor => "/contractor",
                    _ => "/tenant"
                };
                Navigation.NavigateTo(destination, replace: true);
            }
            else
            {
                _errorMessage = "Invalid email or password. Please verify your credentials.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
