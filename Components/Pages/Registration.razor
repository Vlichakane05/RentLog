@page "/register"
@page "/invite"
@attribute [AllowAnonymous]

<PageTitle>Join Rent Log</PageTitle>

<AuthPage TitleId="registration-title">
        <a class="brand" href="/" aria-label="Rent Log home">
            <span class="brand-mark" aria-hidden="true">R</span>
            <span>Rent Log</span>
        </a>
        <div class="login-heading">
            <h1 id="registration-title">Join Rent Log</h1>
            <p class="text-secondary">Registration and invitation acceptance will be available when account services are connected. Ask your landlord or property manager for an invite.</p>
        </div>
        <a class="btn btn-primary sign-in-button" href="/login">Back to sign in</a>
</AuthPage>
