@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Password help | Rent Log</PageTitle>

<AuthPage TitleId="password-help-title">
        <a class="brand" href="/" aria-label="Rent Log home">
            <span class="brand-mark" aria-hidden="true">R</span>
            <span>Rent Log</span>
        </a>
        <div class="login-heading">
            <h1 id="password-help-title">Password help</h1>
            <p class="text-secondary">Password recovery will be available when account services are connected. For now, contact your property manager for help with your demo account.</p>
        </div>
        <a class="btn btn-primary sign-in-button" href="/login">Back to sign in</a>
</AuthPage>
