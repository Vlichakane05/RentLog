    private async Task OnWorkOrderFilesSelected(InputFileChangeEventArgs e)
    {
        _photoUploadError = null;
        try
        {
            var files = e.GetMultipleFiles(5);
            foreach (var file in files)
            {
                if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    _photoUploadError = "Please select valid image files (JPG, PNG, HEIC, WebP).";
                    continue;
                }

                if (file.Size > 10 * 1024 * 1024)
                {
                    _photoUploadError = $"File '{file.Name}' exceeds the 10MB limit.";
                    continue;
                }

                if (_workOrderUploadedUrls.Count >= 5)
                {
                    _photoUploadError = "Maximum 5 photos allowed per request.";
                    break;
                }

                // Read and encode image to data URL for immediate preview and database storage
                await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var base64 = Convert.ToBase64String(memoryStream.ToArray());
                var dataUrl = $"data:{file.ContentType};base64,{base64}";

                if (!_workOrderUploadedUrls.Contains(dataUrl))
                {
                    _workOrderUploadedUrls.Add(dataUrl);
                }
            }
        }
        catch (Exception ex)
        {
            _photoUploadError = $"Could not process selected image: {ex.Message}";
        }
    }

    private void AddManualPhotoUrl()
    {
        if (!string.IsNullOrWhiteSpace(_manualPhotoUrl) && !_workOrderUploadedUrls.Contains(_manualPhotoUrl.Trim()))
        {
            _workOrderUploadedUrls.Add(_manualPhotoUrl.Trim());
            _manualPhotoUrl = string.Empty;
        }
    }

    private void RemoveWorkOrderPhoto(string url)
    {
        _workOrderUploadedUrls.Remove(url);
    }

    private async Task HandleCreateWorkOrderAsync()
    {
        _isSubmittingWorkOrder = true;
        _workOrderSubmitError = null;
        try
        {
            var tenantId = _currentUser != null && Guid.TryParse(_currentUser.Id, out var id) ? id : MockPropertyManagementService.DemoTenantId;
            var wo = new WorkOrderEntity
            {
                UnitId = _activeUnit?.Id ?? Guid.Empty,
                LoggedById = tenantId,
                Category = _workOrderModel.Category,
                Priority = _workOrderModel.Priority,
                Status = "LOGGED",
                Title = _workOrderModel.Title,
                Description = _workOrderModel.Description,
                ScheduledAccessTime = _workOrderModel.ScheduledAccessTime,
                CreatedAt = DateTime.UtcNow
            };
            var created = await PropertyService.CreateWorkOrderAsync(wo);

            // Upload any attached pictures as initial BEFORE_PHOTO proof media
            foreach (var url in _workOrderUploadedUrls)
            {
                try
                {
                    var media = new JobProofMediaEntity
                    {
                        WorkOrderId = created.Id,
                        UploadedById = tenantId,
                        ProofType = "BEFORE_PHOTO",
                        MediaUrl = url,
                        CreatedAt = DateTime.UtcNow
                    };
                    await PropertyService.UploadProofMediaAsync(media);
                }
                catch (Exception mediaEx)
                {
                    // If RLS blocks photo insert, capture message and don't crash circuit
                    _workOrderSubmitError = $"Work order was created, but some pictures couldn't be saved: {mediaEx.Message}";
                }
            }

            if (_workOrderSubmitError is null)
            {
                _showWorkOrderModal = false;
                _workOrderUploadedUrls.Clear();
            }
            await LoadTenantDataAsync();
            _activeTab = "WORK_ORDERS";
        }
        catch (Exception ex)
        {
            _workOrderSubmitError = $"Failed to create work order: {ex.Message}";
        }
        finally
        {
            _isSubmittingWorkOrder = false;
        }
    }

