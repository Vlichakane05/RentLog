@page "/tenant"
@using System.Security.Claims
@using RentLog.Models
@using RentLog.Models.Entities
@inject IPropertyManagementService PropertyService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject RentLogAuthStateProvider AuthStateProvider

<PageTitle>Tenant Portal - RentLog</PageTitle>

<div class="tenant-dashboard-shell min-h-screen bg-slate-950 text-slate-100 font-sans pb-16">
    @Header

    @if (_isLoading)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col items-center justify-center">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-500 border-t-transparent mb-4"></div>
            <p class="text-sm text-slate-400">Loading tenancy records and active maintenance requests...</p>
        </div>
    }
    else
    {
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
            @if (!string.IsNullOrWhiteSpace(_actionError))
            {
                <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm">@_actionError</div>
            }

            @if (_pendingInvites.Count > 0)
            {
                <section class="space-y-3">
                    <div>
                        <h2 class="text-base font-bold text-white">Building invites</h2>
                        <p class="text-xs text-slate-400">Accept an invite to join a unit, or dismiss it if it was sent in error.</p>
                    </div>
                    @foreach (var invite in _pendingInvites)
                    {
                        var unit = _inviteUnits.FirstOrDefault(u => u.Id == invite.UnitId);
                        <div class="bg-slate-900 border border-indigo-500/30 rounded-2xl p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <p class="text-[10px] uppercase tracking-wider text-indigo-400 font-semibold mb-1">Pending invite</p>
                                <h3 class="text-base font-bold text-white">@(unit != null ? $"{unit.BuildingName} • {unit.UnitNumber}" : "Property unit")</h3>
                                <p class="text-xs text-slate-400 mt-1">@(unit?.StreetAddress ?? "Address will appear after you accept")</p>
                                <p class="text-xs text-slate-500 mt-2">Proposed lease @invite.StartDate.ToString("dd MMM yyyy") – @invite.EndDate.ToString("dd MMM yyyy")</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" @onclick="@(() => DismissInviteAsync(invite.Id))" disabled="@_isActing"
                                        class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700 disabled:opacity-50">
                                    Dismiss
                                </button>
                                <button type="button" @onclick="@(() => AcceptInviteAsync(invite.Id))" disabled="@_isActing"
                                        class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow disabled:opacity-50">
                                    Accept invite
                                </button>
                            </div>
                        </div>
                    }
                </section>
            }

            @if (_activeUnit == null)
            {
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-12 text-center max-w-xl mx-auto">
                    <div class="w-12 h-12 rounded-xl bg-slate-800 text-slate-400 mx-auto flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                    </div>
                    <h2 class="text-lg font-bold text-white">No building assigned</h2>
                    <p class="text-sm text-slate-400 mt-2 leading-relaxed">
                        You have not been added to a property yet. When a landlord invites you, it will appear above so you can accept or dismiss it. Until then, your tenant portal stays empty.
                    </p>
                </div>
            }
            else
            {
            <!-- Portal Navigation Tabs -->
            <div class="flex border-b border-slate-800 space-x-2 sm:space-x-4 mb-6 overflow-x-auto scrollbar-none">
                <button type="button" @onclick="@(() => _activeTab = "LEASE")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "LEASE" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Lease & Unit Info</span>
                </button>

                <button type="button" @onclick="@(() => _activeTab = "PAYMENTS")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "PAYMENTS" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Payments & Utilities</span>
                    @if (_payments.Any(p => p.Status == "PENDING"))
                    {
                        <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-rose-500/20 text-rose-300 border border-rose-500/30">Due</span>
                    }
                </button>

                <button type="button" @onclick="@(() => _activeTab = "WORK_ORDERS")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "WORK_ORDERS" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Maintenance Requests</span>
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-800 text-slate-300">@_workOrders.Count</span>
                </button>

                <button type="button" @onclick="@(() => _activeTab = "INSPECTIONS")" 
                        class="pb-3 px-3 sm:px-4 text-sm font-semibold border-b-2 flex items-center space-x-2 transition-colors whitespace-nowrap @(_activeTab == "INSPECTIONS" ? "border-indigo-500 text-indigo-400" : "border-transparent text-slate-400 hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    <span>Digital Inspections</span>
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-800 text-slate-300">@_inspections.Count</span>
                </button>
            </div>

            <!-- TAB 1: LEASE & UNIT INFO -->
            @if (_activeTab == "LEASE")
            {
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Unit Card -->
                    <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 mb-2">
                                    Active Tenancy
                                </span>
                                <h2 class="text-xl font-bold text-white">@(_activeUnit?.BuildingName ?? "Residence") &bull; @(_activeUnit?.UnitNumber ?? "Unit")</h2>
                                <p class="text-sm text-slate-400 mt-1 flex items-center">
                                    <svg class="w-4 h-4 mr-1 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                    @(_activeUnit?.StreetAddress ?? "Address on file")
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="text-xs uppercase tracking-wider text-slate-400">Monthly Rent</span>
                                <p class="text-2xl font-black text-white">R @(_activeUnit?.MonthlyRent.ToString("N2") ?? "0.00")</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-slate-800">
                            <div class="p-3 bg-slate-800/40 rounded-xl border border-slate-800">
                                <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Deposit Held</span>
                                <p class="text-base font-bold text-slate-200 mt-1">R @(_activeUnit?.DepositAmount.ToString("N2") ?? "0.00")</p>
                            </div>
                            <div class="p-3 bg-slate-800/40 rounded-xl border border-slate-800">
                                <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Lease Start</span>
                                <p class="text-base font-bold text-slate-200 mt-1">@(_activeTenancy?.StartDate.ToString("dd MMM yyyy") ?? "-")</p>
                            </div>
                            <div class="p-3 bg-slate-800/40 rounded-xl border border-slate-800">
                                <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Lease End</span>
                                <p class="text-base font-bold text-slate-200 mt-1">@(_activeTenancy?.EndDate.ToString("dd MMM yyyy") ?? "-")</p>
                            </div>
                            <div class="p-3 bg-slate-800/40 rounded-xl border border-slate-800">
                                <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Rent Share</span>
                                <p class="text-base font-bold text-indigo-400 mt-1">100% (Primary)</p>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Action Card -->
                    <div class="bg-gradient-to-br from-indigo-900/40 to-slate-900 border border-indigo-500/20 rounded-2xl p-6 flex flex-col justify-between">
                        <div>
                            <h3 class="text-base font-bold text-white mb-2">Need Assistance?</h3>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                Log maintenance work orders directly for your unit. Our assigned contractors respond with verified digital quotes and timestamps.
                            </p>
                        </div>
                        <div class="mt-6 space-y-2">
                            <button type="button" @onclick="OpenWorkOrderModal" 
                                    class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center space-x-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                <span>Log Maintenance Request</span>
                            </button>
                            <button type="button" @onclick="OpenPaymentModal" 
                                    class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-all flex items-center justify-center space-x-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <span>Pay Rent or Deposit</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 2: PAYMENTS & UTILITIES -->
            @if (_activeTab == "PAYMENTS")
            {
                <div class="space-y-8">
                    <!-- Action Bar -->
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <h2 class="text-lg font-bold text-white">Payment & Utility Tokens</h2>
                            <p class="text-xs text-slate-400">Manage rent payments and top-up prepaid meters</p>
                        </div>
                        <div class="flex items-center space-x-3">
                            <button type="button" @onclick="OpenPaymentModal" 
                                    class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow transition-all flex items-center space-x-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                <span>Make Payment</span>
                            </button>
                        </div>
                    </div>

                    <!-- Utility Meters Section -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var meter in _utilityMeters)
                        {
                            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center space-x-2">
                                        <div class="h-8 w-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
                                            @if (meter.MeterType == "ELECTRICITY")
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                                            }
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-white">@meter.MeterType Prepaid Meter</h4>
                                            <span class="text-xs text-slate-400">@meter.VendorProvider</span>
                                        </div>
                                    </div>
                                    <button type="button" @onclick="@(() => OpenTokenModal(meter))"
                                            class="px-3 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 text-xs font-semibold transition-colors">
                                        Buy Token
                                    </button>
                                </div>
                                <div class="bg-slate-950/60 rounded-xl p-3 border border-slate-800/80 font-mono text-xs text-slate-300 flex justify-between items-center">
                                    <span>Meter No: <strong>@meter.MeterNumber</strong></span>
                                    <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">Active</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Purchased Utility Tokens Table -->
                    @if (_utilityTokens.Any())
                    {
                        <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
                            <div class="px-6 py-4 border-b border-slate-800">
                                <h3 class="text-sm font-bold text-white uppercase tracking-wider">Purchased Utility Tokens</h3>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs">
                                    <thead class="bg-slate-800/40 text-slate-400 font-semibold uppercase tracking-wider">
                                        <tr>
                                            <th class="py-3 px-4">Date</th>
                                            <th class="py-3 px-4">Token Code</th>
                                            <th class="py-3 px-4">Units</th>
                                            <th class="py-3 px-4">Meter</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-800">
                                        @foreach (var token in _utilityTokens)
                                        {
                                            <tr class="hover:bg-slate-800/30 transition-colors">
                                                <td class="py-3 px-4 text-slate-400">@token.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                                                <td class="py-3 px-4 font-mono font-bold text-amber-400 text-sm">@token.TokenCode</td>
                                                <td class="py-3 px-4 font-semibold text-slate-200">@token.UnitsPurchased kWh / kL</td>
                                                <td class="py-3 px-4 text-slate-400">@(_utilityMeters.FirstOrDefault(m => m.Id == token.MeterId)?.MeterNumber ?? token.MeterId.ToString()[..8])</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- Payments History Table -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
                        <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center">
                            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Payment History</h3>
                            <span class="text-xs text-slate-400">@_payments.Count total recorded</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-slate-800/40 text-slate-400 font-semibold uppercase tracking-wider">
                                    <tr>
                                        <th class="py-3 px-4">Date</th>
                                        <th class="py-3 px-4">Description</th>
                                        <th class="py-3 px-4">Method</th>
                                        <th class="py-3 px-4">Reference</th>
                                        <th class="py-3 px-4 text-right">Amount</th>
                                        <th class="py-3 px-4 text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800">
                                    @if (!_payments.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="py-8 text-center text-slate-500">No payment history recorded.</td>
                                        </tr>
                                    }
                                    @foreach (var payment in _payments)
                                    {
                                        <tr class="hover:bg-slate-800/30 transition-colors">
                                            <td class="py-3 px-4 text-slate-400">@payment.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td class="py-3 px-4 font-medium text-slate-200">@payment.Description</td>
                                            <td class="py-3 px-4 text-slate-400">@payment.Method</td>
                                            <td class="py-3 px-4 font-mono text-slate-500">@(payment.GatewayReference ?? "-")</td>
                                            <td class="py-3 px-4 text-right font-bold text-white">R @payment.Amount.ToString("N2")</td>
                                            <td class="py-3 px-4 text-center">
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(payment.Status switch
                                                {
                                                    "SETTLED" => "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
                                                    "FAILED" => "bg-rose-500/20 text-rose-400 border border-rose-500/30",
                                                    "PROCESSING" => "bg-sky-500/20 text-sky-400 border border-sky-500/30",
                                                    _ => "bg-amber-500/20 text-amber-400 border border-amber-500/30"
                                                })">@payment.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 3: WORK ORDERS -->
            @if (_activeTab == "WORK_ORDERS")
            {
                <div class="space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-bold text-white">Maintenance Work Orders</h2>
                            <p class="text-xs text-slate-400">Track logged issues, contractor assignments, and repair status</p>
                        </div>
                        <button type="button" @onclick="OpenWorkOrderModal" 
                                class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow transition-all flex items-center space-x-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>New Work Order</span>
                        </button>
                    </div>

                    @if (!_workOrders.Any())
                    {
                        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-12 text-center">
                            <div class="w-12 h-12 rounded-xl bg-slate-800 text-slate-400 mx-auto flex items-center justify-center mb-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            </div>
                            <h3 class="text-base font-bold text-white">All systems operational</h3>
                            <p class="text-xs text-slate-400 mt-1">No pending maintenance issues logged for your unit.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var wo in _workOrders)
                            {
