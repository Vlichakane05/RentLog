    private async Task HandleSubmitPaymentAsync()
    {
        if (_isActing)
            return;

        _isActing = true;
        _paymentError = null;
        try
        {
            if (_currentUser?.Role != UserRole.Tenant ||
                !Guid.TryParse(_currentUser.Id, out var tenantId))
            {
                throw new InvalidOperationException("A signed-in tenant account is required to record a rental payment.");
            }

            var payment = new PaymentEntity
            {
                TenancyId = _paymentModel.TenancyId,
                PayerId = tenantId,
                Amount = _paymentModel.Amount,
                Description = _paymentModel.Description,
                Method = _paymentModel.Method,
                Status = "SETTLED",
                PaidAt = DateTime.UtcNow,
                CreatedAt = DateTime.UtcNow
            };
            await PropertyService.RecordPaymentAsync(payment);
            _showPaymentModal = false;
            await LoadTenantDataAsync();
        }
        catch (Exception ex)
