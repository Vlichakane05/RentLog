                                            <img src="@url" alt="Attached photo" class="w-full h-full object-cover" />
                                            <button type="button" @onclick="@(() => RemoveWorkOrderPhoto(url))"
                                                    class="absolute top-1 right-1 bg-rose-600/80 hover:bg-rose-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px]"
                                                    title="Remove picture">✕</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="pt-4 flex justify-end space-x-2">
                        <button type="button" @onclick="@(() => _showWorkOrderModal = false)" disabled="@_isSubmittingWorkOrder" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 disabled:opacity-50">Cancel</button>
