                        @if (!string.IsNullOrWhiteSpace(_photoUploadError))
                        {
                            <p class="text-rose-400 text-[11px]">@_photoUploadError</p>
                        }

                        @if (_workOrderUploadedUrls.Count > 0)
                        {
                            <div class="mt-2 space-y-1">
                                <span class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1">
