    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    // existing code continues below...


    private AuthUser? _currentUser;
    private bool _isLoading = true;
    private string _activeTab = "LEASE";

    private UnitEntity? _activeUnit;
    private TenancyEntity? _activeTenancy;
    private List<PaymentEntity> _payments = new();
    private List<UtilityMeterEntity> _utilityMeters = new();
    private List<UtilityTokenEntity> _utilityTokens = new();
    private List<WorkOrderEntity> _workOrders = new();
    private List<ContractorProfileEntity> _contractors = new();
    private List<InspectionEntity> _inspections = new();
    private List<TenancyInviteEntity> _pendingInvites = new();
    private List<UnitEntity> _inviteUnits = new();
    private bool _isActing;
    private string? _actionError;

    // Modals
    private bool _showPaymentModal;
    private MakePaymentViewModel _paymentModel = new();
    private string? _paymentError;

    private bool _showTokenModal;
    private UtilityMeterEntity? _selectedMeter;
    private PurchaseTokenViewModel _tokenModel = new();

    private bool _showWorkOrderModal;
    private CreateWorkOrderViewModel _workOrderModel = new();
    private List<string> _workOrderUploadedUrls = new();
    private string _manualPhotoUrl = string.Empty;
    private string? _photoUploadError;
    private string? _workOrderSubmitError;
    private bool _isSubmittingWorkOrder;
    private List<JobProofMediaEntity> _workOrderProofMedia = new();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
        await LoadTenantDataAsync();
    }

    private async Task LoadTenantDataAsync()
    {
        _isLoading = true;
        _actionError = null;
        _activeUnit = null;
        _activeTenancy = null;
        _payments.Clear();
        _utilityMeters.Clear();
        _utilityTokens.Clear();
        _workOrders.Clear();
        _inspections.Clear();
        _pendingInvites.Clear();
        _inviteUnits.Clear();
        try
        {
            var tenantId = _currentUser != null && Guid.TryParse(_currentUser.Id, out var id)
                ? id
                : Guid.Empty;

            if (tenantId != Guid.Empty)
            {
                _pendingInvites = (await PropertyService.GetPendingInvitesForTenantAsync(tenantId, _currentUser?.Email)).ToList();
                foreach (var invite in _pendingInvites)
                {
                    var unit = await PropertyService.GetUnitByIdAsync(invite.UnitId);
                    if (unit != null && _inviteUnits.All(u => u.Id != unit.Id))
                        _inviteUnits.Add(unit);
                }

                _activeTenancy = await PropertyService.GetActiveTenancyForTenantAsync(tenantId);
                if (_activeTenancy != null)
                {
                    _activeUnit = await PropertyService.GetUnitByIdAsync(_activeTenancy.UnitId);
                    _payments = (await PropertyService.GetPaymentsForTenancyAsync(_activeTenancy.Id)).ToList();
                    _utilityMeters = (await PropertyService.GetUtilityMetersForUnitAsync(_activeTenancy.UnitId)).ToList();
                    _inspections = (await PropertyService.GetInspectionsForTenancyAsync(_activeTenancy.Id)).ToList();
                }

                _utilityTokens = (await PropertyService.GetUtilityTokensForTenantAsync(tenantId)).ToList();
                _workOrders = (await PropertyService.GetWorkOrdersForTenantAsync(tenantId)).ToList();

                _workOrderProofMedia.Clear();
                foreach (var wo in _workOrders)
                {
                    var media = await PropertyService.GetProofMediaForWorkOrderAsync(wo.Id);
                    _workOrderProofMedia.AddRange(media);
                }
            }

            _contractors = (await PropertyService.GetContractorProfilesAsync()).ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Guid CurrentTenantId =>
        _currentUser != null && Guid.TryParse(_currentUser.Id, out var id) ? id : Guid.Empty;

    private async Task AcceptInviteAsync(Guid inviteId)
    {
        if (CurrentTenantId == Guid.Empty) return;
        _isActing = true;
        _actionError = null;
