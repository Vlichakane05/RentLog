                            @if (_isSubmittingWorkOrder)
                            {
                                <span class="animate-spin inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></span>
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>Submit Request</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
   
</div>


