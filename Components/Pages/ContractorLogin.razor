@page "/contractor/login"
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject RentLogAuthStateProvider RentLogAuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Contractor Access - RentLog</PageTitle>

<div class="min-h-screen bg-slate-950 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden font-sans">
    <!-- Amber ambient lighting for contractor branding -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full space-y-8 bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl relative z-10">
        <!-- Logo and header -->
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-500/30 text-amber-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-white">Contractor Dispatch</h2>
            <p class="mt-2 text-sm text-slate-400">
                Enter your work order security PIN or temporary access password to view and execute assigned jobs.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm flex items-start space-x-2.5">
                <svg class="w-5 h-5 flex-shrink-0 text-rose-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@_errorMessage</span>
            </div>
        }

        <EditForm Model="@_model" OnValidSubmit="HandleContractorLoginAsync" class="mt-8 space-y-5">
            <DataAnnotationsValidator />

            <!-- Job PIN or Temporary Password -->
            <div>
                <label for="jobPin" class="block text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1.5">
                    Temporary Password / Job PIN
                </label>
                <div class="relative">
                    <InputText id="jobPin" @bind-Value="_model.JobPin"
                               placeholder="e.g. 7788 or JOB-PIN" 
                               class="w-full px-3.5 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 text-base font-mono tracking-widest text-center focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors" />
                </div>
                <ValidationMessage For="@(() => _model.JobPin)" class="text-xs text-rose-400 mt-1" />
                <p class="text-xs text-slate-500 mt-1.5 text-center">
                    PINs are issued via SMS or dispatch email by the property owner.
                </p>
            </div>

            <!-- Optional Company / Email -->
            <div>
                <label for="company" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                    Company Name or Contact Email <span class="text-slate-500 lowercase">(optional)</span>
                </label>
                <InputText id="company" @bind-Value="_model.CompanyOrEmail"
                           placeholder="Apex Plumb / tech@example.com" 
                           class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors" />
            </div>

            <!-- Submit Button -->
            <button type="submit" disabled="@_isLoading" 
                    class="w-full mt-2 py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-950 text-sm font-bold shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center space-x-2 disabled:opacity-50">
                @if (_isLoading)
                {
                    <svg class="animate-spin h-4 w-4 text-slate-950" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Authenticating PIN...</span>
                }
                else
                {
                    <span>Unlock Work Order Session</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                }
            </button>
        </EditForm>

        <!-- Navigation Links -->
        <div class="mt-6 pt-6 border-t border-slate-800 text-center space-y-2">
            <p class="text-sm text-slate-400">
                Are you a tenant or landlord? 
                <a href="/login" class="font-semibold text-indigo-400 hover:text-indigo-300 ml-1 transition-colors">Sign in here</a>
            </p>
        </div>
    </div>
</div>

@code {
    private readonly ContractorLoginViewModel _model = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleContractorLoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var user = await AuthService.LoginContractorWithPinAsync(_model.JobPin, _model.CompanyOrEmail);
            if (user != null)
            {
                await RentLogAuthStateProvider.LoginAsync(user);
                Navigation.NavigateTo("/contractor", replace: true);
            }
            else
            {
                _errorMessage = "Invalid temporary password or Job PIN. Please check the PIN provided in your dispatch notice.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
