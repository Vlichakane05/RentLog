@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@if (_isCheckingAccess)
{
    <div class="flex items-center justify-center min-h-[50vh] text-slate-500">
        <svg class="animate-spin -ml-1 mr-3 h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Checking authorization...</span>
    </div>
}
else if (_requiredRole is null)
{
    <RouteView RouteData="@RouteData" DefaultLayout="@typeof(MainLayout)" />
}
else if (_user?.Identity?.IsAuthenticated != true)
{
    @if (_requiredRole == nameof(UserRole.Contractor))
    {
        <RedirectToContractorLogin />
    }
    else
    {
        <RedirectToLogin />
    }
}
else if (!_user.IsInRole(_requiredRole))
{
    <RedirectToRoleHome />
}
else
{
    <RouteView RouteData="@RouteData" DefaultLayout="@typeof(MainLayout)" />
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    private bool _isCheckingAccess = true;
    private string? _requiredRole;
    private System.Security.Claims.ClaimsPrincipal? _user;

    protected override async Task OnParametersSetAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        
        if (path.Equals("tenant", StringComparison.OrdinalIgnoreCase) || path.StartsWith("tenant/", StringComparison.OrdinalIgnoreCase))
        {
            _requiredRole = nameof(UserRole.Tenant);
        }
        else if (path.Equals("landlord", StringComparison.OrdinalIgnoreCase) || path.StartsWith("landlord/", StringComparison.OrdinalIgnoreCase))
        {
            _requiredRole = nameof(UserRole.Landlord);
        }
        else if ((path.Equals("contractor", StringComparison.OrdinalIgnoreCase) || path.StartsWith("contractor/", StringComparison.OrdinalIgnoreCase)) &&
                 !path.Equals("contractor/login", StringComparison.OrdinalIgnoreCase))
        {
            _requiredRole = nameof(UserRole.Contractor);
        }
        else
        {
            _requiredRole = null;
        }

        _isCheckingAccess = _requiredRole is not null;
        _user = _requiredRole is null
            ? null
            : (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _isCheckingAccess = false;
    }
}
