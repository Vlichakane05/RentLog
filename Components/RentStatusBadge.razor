@using RentLog.Models

<span class="badge @CssClass">
    <span aria-hidden="true">@Icon</span>
    <span>@Status</span>
</span>

@code {
    [Parameter]
    public RentPaymentStatus Status { get; set; }

    private string CssClass => Status switch
    {
        RentPaymentStatus.Paid => "badge-success",
        RentPaymentStatus.Overdue => "badge-danger",
        _ => "badge-warning"
    };

    private string Icon => Status switch
    {
        RentPaymentStatus.Paid => "✓",
        RentPaymentStatus.Overdue => "!",
        _ => "◷"
    };
}
