@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject RentLogAuthStateProvider RentLogAuthStateProvider
@implements IDisposable
@using RentLog.Models.Entities

<div class="tenant-layout">
    <header class="bg-blue-600 text-white flex items-center justify-between px-4 py-2 border-b-4 border-blue-800">
        <h1 class="text-xl font-semibold">Rent Log</h1>
        <div class="flex items-center space-x-4">
            <span>Welcome, <strong>@(_currentUser?.Name ?? "User")</strong> (@(_currentUser?.Role.ToString() ?? ""))</span>
            <ThemeToggle />
            <button class="underline" @onclick="HandleLogoutAsync" title="Sign out">Sign out</button>
        </div>
    </header>

    <div class="layout-wrapper">
        <nav class="bottom-nav" aria-label="Main navigation">
            <a href="/tenant" class="nav-item @(IsActive("/tenant") ? "active" : "")" aria-current="@(IsActive("/tenant") ? "page" : null)" title="Issues">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                <span>Issues</span>
            </a>
            <a href="/tenant/history" class="nav-item @(IsActive("/tenant/history") ? "active" : "")" aria-current="@(IsActive("/tenant/history") ? "page" : null)" title="History">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>History</span>
            </a>
            <a href="/tenant/profile" class="nav-item @(IsActive("/tenant/profile") ? "active" : "")" aria-current="@(IsActive("/tenant/profile") ? "page" : null)" title="Profile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <span>Profile</span>
            </a>
        </nav>

        <div class="layout-content">
            @Body
        </div>
    </div>
</div>

@code {
    private string? _currentPath;
    private AuthUser? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        _currentPath = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
        _currentUser = await AuthService.GetCurrentUserAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = e.Location;
        StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var currentPath = GetCurrentPath();
        var normalizedPath = path.Trim('/');
        return string.Equals(currentPath, normalizedPath, StringComparison.OrdinalIgnoreCase)
            || (normalizedPath != "tenant" && currentPath.StartsWith($"{normalizedPath}/", StringComparison.OrdinalIgnoreCase));
    }

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        await RentLogAuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private string GetCurrentPath()
    {
        return Navigation.ToBaseRelativePath(_currentPath ?? Navigation.Uri).Split('?')[0].TrimEnd('/');
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
