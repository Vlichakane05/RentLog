@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject RentLogAuthStateProvider RentLogAuthStateProvider
@implements IDisposable
@using RentLog.Models.Entities

<div class="landlord-layout">
    <header class="bg-blue-600 text-white flex items-center justify-between px-4 py-2 border-b-4 border-blue-800">
        <h1 class="text-xl font-semibold">Rent Log</h1>
        <div class="flex items-center space-x-4">
            <span>Welcome, <strong>@(_currentUser?.Name ?? "User")</strong> (@(_currentUser?.Role.ToString() ?? ""))</span>
            <ThemeToggle />
            <button class="underline" @onclick="HandleLogoutAsync" title="Sign out">Sign out</button>
        </div>
    </header>

    <div class="layout-wrapper">
        <aside class="sidebar" aria-label="Main navigation">
            <nav class="sidebar-nav">
                <a href="/landlord" class="nav-item @(IsActive("/landlord") ? "active" : "")" title="Dashboard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>Dashboard</span>
                </a>
                <a href="/landlord/properties" class="nav-item @(IsActive("/landlord/properties") ? "active" : "")" title="Properties">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 2l3 8h8l-6.5 5 2.5 8-7-5-7 5 2.5-8L1 10h8l3-8z" />
                    </svg>
                    <span>Properties</span>
                </a>
                <a href="/landlord/issues" class="nav-item @(IsActive("/landlord/issues") ? "active" : "")" title="Issues">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <span>Issues</span>
                </a>
                <a href="/landlord/ledger" class="nav-item @(IsActive("/landlord/ledger") ? "active" : "")" title="Rent Ledger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                        <path d="M21 3v5h-5" />
                        <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                        <path d="M3 21v-5h5" />
                    </svg>
                    <span>Rent Ledger</span>
                </a>
                <a href="/landlord/profile" class="nav-item @(IsActive("/landlord/profile") ? "active" : "")" title="Profile">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <span>Profile</span>
                </a>
            </nav>
        </aside>

        <div class="layout-content">
            @Body
        </div>
    </div>
</div>

@code {
    private string? _currentPath;
    private AuthUser? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        _currentPath = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
        _currentUser = await AuthService.GetCurrentUserAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = e.Location;
        StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var currentPath = GetCurrentPath();
        var normalizedPath = path.Trim('/');
        return string.Equals(currentPath, normalizedPath, StringComparison.OrdinalIgnoreCase)
            || (normalizedPath != "landlord" && currentPath.StartsWith($"{normalizedPath}/", StringComparison.OrdinalIgnoreCase));
    }

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        await RentLogAuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private string GetCurrentPath()
    {
        return Navigation.ToBaseRelativePath(_currentPath ?? Navigation.Uri).Split('?')[0].TrimEnd('/');
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
