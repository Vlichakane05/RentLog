@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject RentLogAuthStateProvider RentLogAuthStateProvider

<div class="min-h-screen bg-slate-900 text-slate-100 flex flex-col font-sans">
    <!-- Contractor Header -->
    <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700/80 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="h-9 w-9 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
                    </svg>
                </div>
                <div>
                    <span class="text-lg font-bold tracking-tight text-white">Rent<span class="text-amber-400">Log</span></span>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">Contractor Hub</span>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <AuthorizeView>
                    <Authorized>
                        <div class="hidden sm:flex flex-col text-right">
                            <span class="text-sm font-semibold text-slate-200">@(context.User.Identity?.Name ?? "Contractor")</span>
                            <span class="text-xs text-amber-400">Field Service Session</span>
                        </div>
                        <button @onclick="HandleLogoutAsync" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-700 hover:bg-slate-600 text-slate-300 hover:text-white transition-colors border border-slate-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span>Exit Session</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800 py-4 text-center text-xs text-slate-500">
        RentLog Contractor Service Dispatch &bull; Temporary Job PIN Session Active
    </footer>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        await RentLogAuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/contractor/login", replace: true);
    }
}
