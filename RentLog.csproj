<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>RentLog-LocalDevelopment</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Supabase" Version="8.3.1" />
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild">
    <Exec Command="npx @tailwindcss/cli -i ./wwwroot/css/input.css -o ./wwwroot/css/tailwind.css" ContinueOnError="true" />
  </Target>
</Project>
