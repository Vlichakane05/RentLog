@*
KpiCard component: displays a metric with label, value, optional subtext and icon.
Used for dashboards and summary screens (e.g., "Issues: 12", "Revenue: R 45,000.00").
*@

<div class="kpi-card @CssClass">
	<div class="kpi-header">
		@if (!string.IsNullOrEmpty(Icon))
		{
			<span class="kpi-icon" aria-hidden="true">@Icon</span>
		}
		<h3 class="kpi-label">@Label</h3>
	</div>
	<div class="kpi-value">@Value</div>
	@if (!string.IsNullOrEmpty(Subtext))
	{
		<div class="kpi-subtext">@Subtext</div>
	}
</div>

@code {
	/// <summary>
	/// Label describing the metric (e.g., "Total Issues").
	/// </summary>
	[Parameter]
	public string Label { get; set; } = string.Empty;

	/// <summary>
	/// The value to display (e.g., "12", "R 45,000.00").
	/// </summary>
	[Parameter]
	public string Value { get; set; } = string.Empty;

	/// <summary>
	/// Optional subtext (e.g., "this month" or "pending resolution").
	/// </summary>
	[Parameter]
	public string Subtext { get; set; } = string.Empty;

	/// <summary>
	/// Optional icon or emoji to display.
	/// </summary>
	[Parameter]
	public string Icon { get; set; } = string.Empty;

	/// <summary>
	/// Additional CSS classes to apply.
	/// </summary>
	[Parameter]
	public string CssClass { get; set; } = string.Empty;
}
