@using RentLog.Models

<span class="badge @CssClass">
    <span aria-hidden="true">@Icon</span>
    <span>@Label</span>
</span>

@code {
    [Parameter]
    public Status Status { get; set; }

    private string Label => Status switch
    {
        Status.InProgress => "In progress",
        Status.AwaitingConfirmation => "Awaiting confirmation",
        _ => Status.ToString()
    };

    private string CssClass => Status switch
    {
        Status.Resolved => "badge-success",
        Status.Disputed => "badge-danger",
        Status.Open => "badge-warning",
        _ => "badge-info"
    };

    private string Icon => Status switch
    {
        Status.Resolved => "✓",
        Status.Disputed => "!",
        Status.AwaitingConfirmation => "◷",
        Status.InProgress => "↻",
        Status.Acknowledged => "✓",
        _ => "○"
    };
}
