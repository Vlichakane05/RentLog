@page "/landlord/issues"
@layout LandlordLayout
@inject IAuthService AuthService
@inject IIssueService IssueService
@inject ILogger<LandlordIssues> Logger
@inject NavigationManager Navigation

<PageTitle>Maintenance issues | Rent Log</PageTitle>

<div class="landlord-page">
    <header class="page-heading">
        <p class="eyebrow">MAINTENANCE</p>
        <h1>Tenant issues</h1>
        <p class="text-secondary">Review reports and follow each issue through to resolution.</p>
    </header>

    @if (_isLoading)
    {
        <p role="status" class="text-secondary">Loading issues...</p>
        <LoadingSkeleton Lines="5" />
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    else if (_issues.Count == 0)
    {
        <EmptyState Icon="✓" Title="No maintenance issues" Message="Tenant reports will appear here." />
    }
    else
    {
        <div class="issue-list">
            @foreach (var issue in _issues)
            {
                <article class="issue-list-row @(issue.Severity == Severity.Emergency && issue.Status != Status.Resolved ? "issue-emergency" : string.Empty)" @key="issue.Id">
                    <div class="issue-list-top">
                        <SeverityBadge Severity="@issue.Severity" />
                        <StatusBadge Status="@issue.Status" />
                    </div>
                    <a class="issue-list-title" href="@($"/landlord/issues/{issue.Id}")">@issue.Title</a>
                    <p>Unit @issue.Unit · reported @issue.CreatedAt.ToLocalTime().ToString("dd MMM yyyy", _zaCulture)</p>
                    <a class="btn btn-secondary" href="@($"/landlord/issues/{issue.Id}")">Review issue</a>
                </article>
            }
        </div>
    }
</div>

@code {
    private static readonly CultureInfo _zaCulture = CultureInfo.GetCultureInfo("en-ZA");
    private bool _isLoading = true;
    private string? _errorMessage;
    private List<Issue> _issues = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var landlord = await AuthService.GetCurrentUserAsync();
            if (landlord is null || landlord.Role != UserRole.Landlord)
            {
                Navigation.NavigateTo("/login", replace: true);
                return;
            }

            _issues = (await IssueService.GetLandlordIssuesAsync(landlord.Id))
                .OrderByDescending(issue => issue.Severity)
                .ThenByDescending(issue => issue.CreatedAt)
                .ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load landlord issues.");
            _errorMessage = "We couldn't load maintenance issues. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
