@page "/tenant/history"
@layout TenantLayout
@inject IAuthService AuthService
@inject IRentService RentService
@inject ILogger<TenantRentHistory> Logger
@inject NavigationManager Navigation

<PageTitle>Rent history | Rent Log</PageTitle>

<div class="tenant-page rent-history-page">
    <a class="back-link" href="/tenant">← Back to home</a>
    <header class="page-heading">
        <p class="eyebrow">YOUR RENT</p>
        <h1>Rent history</h1>
        <p class="text-secondary">A month-by-month record of rent due and payments received.</p>
    </header>

    @if (_isLoading)
    {
        <p role="status" class="text-secondary">Loading your rent history...</p>
        <LoadingSkeleton Lines="5" />
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    else if (_entries.Count == 0)
    {
        <EmptyState Icon="🧾" Title="No rent history yet" Message="Your rent records will appear here once your tenancy is linked." />
    }
    else
    {
        <div class="rent-entry-list">
            @foreach (var entry in _entries)
            {
                <article class="rent-entry card" @key="entry.Id">
                    <div class="rent-entry-heading">
                        <div>
                            <h2>@entry.Period.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("en-ZA"))</h2>
                            <p class="text-secondary">Due @FormatDate(entry.DueDate)</p>
                        </div>
                        <RentStatusBadge Status="@entry.Status" />
                    </div>
                    <p class="rent-entry-amount">@FormatCurrency(entry.Amount)</p>
                    @if (entry.Status == RentPaymentStatus.Paid && entry.PaidDate.HasValue)
                    {
                        <p class="rent-payment-date">Paid @FormatDate(entry.PaidDate.Value)</p>
                    }
                    else if (entry.Status == RentPaymentStatus.Overdue)
                    {
                        <p class="rent-payment-date overdue-copy">Payment overdue</p>
                    }
                    else
                    {
                        <p class="rent-payment-date">Payment not yet recorded</p>
                    }
                </article>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private List<RentEntry> _entries = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user is null || user.Role != UserRole.Tenant)
            {
                Navigation.NavigateTo("/login", replace: true);
                return;
            }

            _entries = (await RentService.GetRentHistoryAsync(user.Id)).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load rent history.");
            _errorMessage = "We couldn't load your rent history. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatCurrency(decimal amount) => $"R {amount.ToString("N2", CultureInfo.GetCultureInfo("en-US"))}";
    private static string FormatDate(DateOnly date) => date.ToDateTime(TimeOnly.MinValue).ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("en-ZA"));
}
