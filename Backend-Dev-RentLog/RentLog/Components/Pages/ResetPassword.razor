@page "/reset-password"
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject ILogger<ResetPassword> Logger
@inject NavigationManager Navigation

<PageTitle>Choose a new password | Rent Log</PageTitle>

<AuthPage TitleId="reset-password-title">
    <a class="brand" href="/" aria-label="Rent Log home">
        <span class="brand-mark" aria-hidden="true">R</span>
        <span>Rent Log</span>
    </a>
    <div class="login-heading">
        <h1 id="reset-password-title">Choose a new password</h1>
        <p class="text-secondary">Reset links expire after 30 minutes and can only be used once.</p>
    </div>

    @if (!HasResetLink)
    {
        <div class="alert alert-danger" role="alert">This reset link is incomplete. Request a new one to continue.</div>
        <a class="btn btn-primary sign-in-button" href="/forgot-password">Request a new link</a>
    }
    else if (_complete)
    {
        <div class="alert alert-success" role="status">Your password has been changed. You can now sign in with your new password.</div>
        <a class="btn btn-primary sign-in-button" href="/login">Sign in</a>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="ResetAsync">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label class="form-label" for="new-password">New password</label>
                <InputText id="new-password" class="input" type="password" autocomplete="new-password" @bind-Value="_form.Password" disabled="@_isLoading" />
                <ValidationMessage For="@(() => _form.Password)" />
            </div>
            <div class="form-field">
                <label class="form-label" for="confirm-new-password">Confirm new password</label>
                <InputText id="confirm-new-password" class="input" type="password" autocomplete="new-password" @bind-Value="_form.ConfirmPassword" disabled="@_isLoading" />
                <ValidationMessage For="@(() => _form.ConfirmPassword)" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }
            <button class="btn btn-primary sign-in-button" type="submit" disabled="@_isLoading">
                @if (_isLoading) { <span class="loading-spinner" aria-hidden="true"></span><span>Updating password...</span> }
                else { <span>Update password</span> }
            </button>
        </EditForm>
    }
</AuthPage>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private bool HasResetLink => !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);
    private readonly ResetForm _form = new();
    private bool _isLoading;
    private bool _complete;
    private string? _errorMessage;

    private async Task ResetAsync()
    {
        _errorMessage = null;
        if (!string.Equals(_form.Password, _form.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "The passwords do not match.";
            return;
        }
        _isLoading = true;
        try
        {
            _complete = await AuthService.ResetPasswordAsync(Email!, Token!, _form.Password);
            if (!_complete) _errorMessage = "This reset link is invalid, expired, or already used. Request a new link and try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset failed.");
            _errorMessage = "We couldn't update your password. Request a new reset link and try again.";
        }
        finally { _isLoading = false; }
    }

    private sealed class ResetForm
    {
        [Required(ErrorMessage = "Enter a new password.")]
        [MinLength(8, ErrorMessage = "Your password must contain at least 8 characters.")]
        public string Password { get; set; } = string.Empty;
        [Required(ErrorMessage = "Confirm your new password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
