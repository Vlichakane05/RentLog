@page "/forgot-password"
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Password recovery | Rent Log</PageTitle>

<AuthPage TitleId="password-help-title">
    <a class="brand" href="/" aria-label="Rent Log home">
        <span class="brand-mark" aria-hidden="true">R</span>
        <span>Rent Log</span>
    </a>
    <div class="login-heading">
        <h1 id="password-help-title">Reset your password</h1>
        <p class="text-secondary">Enter the email address associated with your account. If an account exists, we'll send a password-reset link.</p>
    </div>

    @if (_sent)
    {
        <div class="alert alert-success" role="status">If an account matches that email address, a reset link will be sent. Check your inbox and spam folder.</div>
        <a class="btn btn-primary sign-in-button" href="/login">Back to sign in</a>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SendResetAsync">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label class="form-label" for="recovery-email">Email address</label>
                <InputText id="recovery-email" class="input" type="email" autocomplete="email" @bind-Value="_form.Email" disabled="@_isLoading" />
                <ValidationMessage For="@(() => _form.Email)" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }
            <button class="btn btn-primary sign-in-button" type="submit" disabled="@_isLoading">
                @if (_isLoading) { <span class="loading-spinner" aria-hidden="true"></span><span>Sending...</span> }
                else { <span>Send reset link</span> }
            </button>
        </EditForm>
        <p class="register-prompt"><a href="/login">Back to sign in</a></p>
    }
</AuthPage>

@code {
    private readonly RecoveryForm _form = new();
    private bool _isLoading;
    private bool _sent;
    private string? _errorMessage;

    private async Task SendResetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            await AuthService.RequestPasswordResetAsync(_form.Email, new Uri(new Uri(Navigation.BaseUri), "reset-password").ToString());
            _sent = true;
        }
        catch (NotSupportedException ex)
        {
            Logger.LogWarning(ex, "Password recovery is not supported by the configured backend.");
            _errorMessage = "Password recovery is available when the SQL Server account service is configured.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password recovery request failed.");
            // Keep the message generic so account existence is not revealed.
            _sent = true;
        }
        finally { _isLoading = false; }
    }

    private sealed class RecoveryForm
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
