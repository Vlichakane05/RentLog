@*
ConfirmDialog component: confirmation modal for destructive or important actions.
Modal with title, message, and two buttons (Cancel, Confirm).
Uses CSS backdrop for overlay. Keyboard accessible.
*@

@if (IsOpen)
{
	<div class="confirm-dialog-backdrop" @onclick="OnBackdropClick" role="presentation"></div>
	<dialog class="confirm-dialog" open>
		<div class="confirm-dialog-content">
			<h2 class="confirm-dialog-title">@Title</h2>
			@if (!string.IsNullOrEmpty(Message))
			{
				<p class="confirm-dialog-message">@Message</p>
			}
			@if (CustomContent != null)
			{
				<div class="confirm-dialog-custom">
					@CustomContent
				</div>
			}

			<div class="confirm-dialog-actions">
				<button type="button" class="btn btn-secondary" @onclick="OnCancel">
					@CancelLabel
				</button>
				<button type="button" class="btn btn-primary" @onclick="OnConfirm">
					@ConfirmLabel
				</button>
			</div>
		</div>
	</dialog>
}

@code {
	/// <summary>
	/// Whether the dialog is visible.
	/// </summary>
	[Parameter]
	public bool IsOpen { get; set; }

	/// <summary>
	/// Dialog title.
	/// </summary>
	[Parameter]
	public string Title { get; set; } = "Confirm";

	/// <summary>
	/// Dialog message text.
	/// </summary>
	[Parameter]
	public string Message { get; set; } = string.Empty;

	/// <summary>
	/// Optional custom content to display in the dialog.
	/// </summary>
	[Parameter]
	public RenderFragment? CustomContent { get; set; }

	/// <summary>
	/// Label for the cancel button.
	/// </summary>
	[Parameter]
	public string CancelLabel { get; set; } = "Cancel";

	/// <summary>
	/// Label for the confirm button.
	/// </summary>
	[Parameter]
	public string ConfirmLabel { get; set; } = "Confirm";

	/// <summary>
	/// Callback when dialog is confirmed.
	/// </summary>
	[Parameter]
	public EventCallback OnConfirmed { get; set; }

	/// <summary>
	/// Callback when dialog is cancelled or backdrop is clicked.
	/// </summary>
	[Parameter]
	public EventCallback OnCancelled { get; set; }

	private async Task OnConfirm()
	{
		await OnConfirmed.InvokeAsync();
	}

	private async Task OnCancel()
	{
		await OnCancelled.InvokeAsync();
	}

	private async Task OnBackdropClick()
	{
		await OnCancelled.InvokeAsync();
	}
}
