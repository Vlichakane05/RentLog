@inject RentLog.Services.BackendMode BackendMode
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/tokens.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RentLog.styles.css"]" />
    <script src="js/theme.js"></script>
    <script src="js/media.js"></script>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @if (BackendMode.UsesMockData)
    {
        <div class="backend-mode-banner" role="status">
            <strong>Development demo mode</strong>
            <span>@BackendMode.SetupMessage</span>
        </div>
    }
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
