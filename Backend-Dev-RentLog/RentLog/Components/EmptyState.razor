@*
EmptyState component: placeholder when there's no data to display.
Shows icon, title, and optional message. Can include a call-to-action button.
*@

<div class="empty-state @CssClass">
	@if (!string.IsNullOrEmpty(Icon))
	{
		<div class="empty-state-icon" aria-hidden="true">@Icon</div>
	}
	<h2 class="empty-state-title">@Title</h2>
	@if (!string.IsNullOrEmpty(Message))
	{
		<p class="empty-state-message">@Message</p>
	}
	@if (Action != null)
	{
		<div class="empty-state-action">
			@Action
		</div>
	}
</div>

@code {
	/// <summary>
	/// Icon or emoji to display (large).
	/// </summary>
	[Parameter]
	public string Icon { get; set; } = string.Empty;

	/// <summary>
	/// Empty state title.
	/// </summary>
	[Parameter]
	public string Title { get; set; } = "No data";

	/// <summary>
	/// Optional descriptive message.
	/// </summary>
	[Parameter]
	public string Message { get; set; } = string.Empty;

	/// <summary>
	/// Optional action button or content.
	/// </summary>
	[Parameter]
	public RenderFragment? Action { get; set; }

	/// <summary>
	/// Additional CSS classes to apply.
	/// </summary>
	[Parameter]
	public string CssClass { get; set; } = string.Empty;
}
