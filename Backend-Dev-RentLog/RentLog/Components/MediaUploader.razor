@using RentLog.Services
@inject IMediaService MediaService
@inject IJSRuntime JavaScript
@inject ILogger<MediaUploader> Logger

<div class="media-uploader @CssClass">
	<!-- Error messages -->
	@if (!string.IsNullOrEmpty(ErrorMessage))
	{
		<div class="uploader-error" role="alert">
			<span class="error-icon">⚠</span>
			<span>@ErrorMessage</span>
			<button type="button" class="error-close" @onclick="ClearError" aria-label="Dismiss error">✕</button>
		</div>
	}

	<!-- File input (camera/gallery) -->
	<div class="uploader-input-group">
		<div @ref="_filePickerContainer">
			<InputFile
				id="@InputId"
				class="uploader-file-input"
				multiple
				accept="image/jpeg,image/png,image/heic,video/mp4,video/quicktime"
				OnChange="OnFilesSelected"
				disabled="@IsUploading"
				aria-label="Upload photos or videos" />
		</div>

		<label for="@InputId" class="uploader-label @(IsUploading ? "disabled" : string.Empty)">
			<span class="uploader-icon">📸</span>
			<div class="uploader-text">
				<span class="uploader-title">@(IsUploading ? "Uploading..." : "Tap to upload")</span>
				<span class="uploader-hint">Photos (JPG, PNG, HEIC) max 10 MB × 5<br />Videos (MP4, MOV) max 50 MB, 30 sec × 2</span>
			</div>
		</label>
	</div>

	<!-- Count info -->
	<div class="uploader-count" aria-live="polite">
		Photos: @SelectedMedia.Count(m => m.MimeType.StartsWith("image")) / 5
		&nbsp;&nbsp;Videos: @SelectedMedia.Count(m => m.MimeType.StartsWith("video")) / 2
	</div>

	<!-- Thumbnails grid -->
	@if (SelectedMedia.Count > 0)
	{
		<div class="uploader-thumbnails">
			@foreach (var media in SelectedMedia)
			{
				<div class="thumbnail-item" key="@media.Id">
					<!-- Thumbnail preview -->
					@if (media.MimeType.StartsWith("image"))
					{
						<img
							src="@media.ThumbnailBase64"
							alt="@media.AltText"
							class="thumbnail-img"
							loading="lazy" />
					}
					else if (media.MimeType.StartsWith("video"))
					{
						<div class="thumbnail-video">
							<span class="video-play-icon">▶</span>
							<span class="video-duration">
								@(media.DurationSeconds.HasValue ? $"{(int)media.DurationSeconds.Value}s" : "")
							</span>
						</div>
					}

					<!-- Remove button -->
					<button
						type="button"
						class="thumbnail-remove"
						@onclick="() => RemoveMedia(media.Id)"
						disabled="@IsUploading"
						aria-label="Remove @media.FileName">
						✕
					</button>

					<!-- File info -->
					<div class="thumbnail-info">
						<span class="thumbnail-name">@System.IO.Path.GetFileName(media.FileName)</span>
						<span class="thumbnail-size">@FormatBytes(media.FileSizeBytes)</span>
					</div>

					<!-- Upload progress bar -->
					@if (IsUploading && CurrentUploadId == media.Id)
					{
						<div class="thumbnail-progress">
							<div class="progress-bar" style="width: @(UploadProgress)%"></div>
						</div>
					}
				</div>
			}
		</div>
	}

	<!-- Upload button -->
	@if (SelectedMedia.Count > 0 && !IsUploading)
	{
		<div class="uploader-actions">
			<button
				type="button"
				class="btn btn-primary"
				@onclick="UploadAllMedia"
				aria-busy="@IsUploading">
				Upload @(SelectedMedia.Count) file@(SelectedMedia.Count != 1 ? "s" : "")
			</button>
		</div>
	}

	<!-- Uploaded URLs (for confirmation) -->
	@if (UploadedUrls.Count > 0)
	{
		<div class="uploader-success" role="status">
			<span class="success-icon">✓</span>
			<span>@UploadedUrls.Count file@(UploadedUrls.Count != 1 ? "s" : "") uploaded successfully</span>
		</div>
	}
</div>

@code {
	/// <summary>
	/// Callback when media files are uploaded successfully.
	/// Receives list of uploaded URLs.
	/// </summary>
	[Parameter]
	public EventCallback<List<string>> OnMediaUploaded { get; set; }

	[Parameter]
	public EventCallback<bool> OnPendingMediaChanged { get; set; }

	/// <summary>
	/// Optional: callback for real-time progress updates.
	/// </summary>
	[Parameter]
	public EventCallback<int> OnProgressChanged { get; set; }

	/// <summary>
	/// Additional CSS classes.
	/// </summary>
	[Parameter]
	public string CssClass { get; set; } = string.Empty;

	private List<MediaFile> SelectedMedia { get; set; } = new();
	private List<string> UploadedUrls { get; set; } = new();
	private string ErrorMessage { get; set; } = string.Empty;
	private bool IsUploading { get; set; }
	private int UploadProgress { get; set; }
	private string CurrentUploadId { get; set; } = string.Empty;
	private string InputId { get; set; } = $"media-input-{Guid.NewGuid()}";
	private ElementReference _filePickerContainer;

	private async Task OnFilesSelected(InputFileChangeEventArgs e)
	{
		ClearError();

		IReadOnlyList<IBrowserFile> files;
		try
		{
			files = e.GetMultipleFiles(7);
		}
		catch (InvalidOperationException)
		{
			ErrorMessage = "Select no more than 5 photos and 2 videos at a time.";
			return;
		}

		for (var fileIndex = 0; fileIndex < files.Count; fileIndex++)
		{
			var file = files[fileIndex];
			var mimeType = file.ContentType.ToLowerInvariant();
			var isImage = mimeType.StartsWith("image");
			var isVideo = mimeType.StartsWith("video");

			if (isImage)
			{
				var error = MediaService.ValidatePhoto(mimeType, file.Size);
				if (error != null)
				{
					ErrorMessage = error;
					break;
				}

				var photoCount = SelectedMedia.Count(m => m.MimeType.StartsWith("image"));
				if (photoCount >= 5 || files.Count(m => m.ContentType.StartsWith("image", StringComparison.OrdinalIgnoreCase)) > 5 - photoCount)
				{
					ErrorMessage = "Maximum 5 photos allowed.";
					break;
				}
			}
			else if (isVideo)
			{
				var error = MediaService.ValidateVideo(mimeType, file.Size, null);
				if (error != null)
				{
					ErrorMessage = error;
					break;
				}

				var videoCount = SelectedMedia.Count(m => m.MimeType.StartsWith("video"));
				if (videoCount >= 2 || files.Count(m => m.ContentType.StartsWith("video", StringComparison.OrdinalIgnoreCase)) > 2 - videoCount)
				{
					ErrorMessage = "Maximum 2 videos allowed.";
					break;
				}
			}
			else
			{
				ErrorMessage = "Only photos and videos accepted.";
				break;
			}

			var media = new MediaFile
			{
				FileName = file.Name,
				MimeType = mimeType,
				FileSizeBytes = file.Size,
				AltText = Path.GetFileNameWithoutExtension(file.Name)
			};

			if (isVideo)
			{
				try
				{
					await using var stream = file.OpenReadStream(maxAllowedSize: MediaService.MaxVideoSizeBytes);
					using var memoryStream = new MemoryStream();
					await stream.CopyToAsync(memoryStream);
					media.Base64Data = Convert.ToBase64String(memoryStream.ToArray());
				}
				catch (Exception exception) when (exception is IOException or InvalidOperationException)
				{
					ErrorMessage = $"Could not read {file.Name}. Please select it again.";
					break;
				}
			}

			if (isImage)
			{
				try
				{
					media.ThumbnailBase64 = await CompressImage(fileIndex, mimeType, 200, 200);
					media.Base64Data = await CompressImage(fileIndex, mimeType, 1600, 1600);
					media.FileSizeBytes = (long)(media.Base64Data.Length * 0.75);
					media.MimeType = mimeType.Equals("image/png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";
					media.FileName = Path.ChangeExtension(file.Name, media.MimeType == "image/png" ? ".png" : ".jpg");
					media.ThumbnailBase64 = $"data:{media.MimeType};base64,{media.ThumbnailBase64}";
					media.Base64Data = $"data:{media.MimeType};base64,{media.Base64Data}";
				}
				catch (JSException)
				{
					ErrorMessage = $"Could not process {file.Name} in this browser. Try a JPG or PNG image.";
					break;
				}
			}
			else if (isVideo)
			{
				try
				{
					media.DurationSeconds = await JavaScript.InvokeAsync<double>("rentLogMedia.getVideoDurationFromInput", _filePickerContainer, fileIndex);
				}
				catch (JSException)
				{
					ErrorMessage = $"Could not read the duration of {file.Name}. Try another MP4 or MOV file.";
					break;
				}

				var durationError = MediaService.ValidateVideo(mimeType, file.Size, media.DurationSeconds);
				if (durationError is not null)
				{
					ErrorMessage = durationError;
					break;
				}
			}

			SelectedMedia.Add(media);
		}

		await OnPendingMediaChanged.InvokeAsync(SelectedMedia.Any(media => media.UploadedUrl is null));
	}

	private async Task RemoveMedia(string mediaId)
	{
		SelectedMedia.RemoveAll(m => m.Id == mediaId);
		ClearError();
		UploadedUrls = SelectedMedia
			.Where(media => media.UploadedUrl is not null)
			.Select(media => media.UploadedUrl!)
			.ToList();
		await OnMediaUploaded.InvokeAsync(UploadedUrls);
		await OnPendingMediaChanged.InvokeAsync(SelectedMedia.Any(media => media.UploadedUrl is null));
	}

	private async Task UploadAllMedia()
	{
		if (SelectedMedia.Count == 0)
			return;

		IsUploading = true;
		ClearError();
		try
		{
			foreach (var media in SelectedMedia.Where(media => media.UploadedUrl is null))
			{
				CurrentUploadId = media.Id;
				var progress = new Progress<int>(p =>
				{
					UploadProgress = p;
					OnProgressChanged.InvokeAsync(p);
				});

				var url = await MediaService.UploadAsync(media, progress);
				if (url is null)
				{
					ErrorMessage = $"Upload failed for {media.FileName}. Check your connection and try again.";
					break;
				}

				media.UploadedUrl = url;
			}
		}
		catch (Exception exception)
		{
			Logger.LogError(exception, "Failed to upload issue evidence.");
			ErrorMessage = "An upload failed. Check your connection and try again.";
		}

		IsUploading = false;
		CurrentUploadId = string.Empty;
		UploadProgress = 0;

		UploadedUrls = SelectedMedia
			.Where(media => media.UploadedUrl is not null)
			.Select(media => media.UploadedUrl!)
			.ToList();
		if (UploadedUrls.Count > 0)
		{
			await OnMediaUploaded.InvokeAsync(UploadedUrls);
		}

		await OnPendingMediaChanged.InvokeAsync(SelectedMedia.Any(media => media.UploadedUrl is null));
	}

	private async Task<string> CompressImage(int fileIndex, string mimeType, int maxWidth, int maxHeight)
	{
		return await JavaScript.InvokeAsync<string>("rentLogMedia.compressSelectedImage", _filePickerContainer, fileIndex, mimeType, maxWidth, maxHeight);
	}

	private void ClearError() => ErrorMessage = string.Empty;

	private string FormatBytes(long bytes)
	{
		if (bytes < 1024)
			return $"{bytes} B";
		if (bytes < 1024 * 1024)
			return $"{bytes / 1024} KB";
		return $"{bytes / (1024.0 * 1024):F1} MB";
	}
}
