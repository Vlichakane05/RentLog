@*
LoadingSkeleton component: animated placeholder for loading states.
Shows skeleton bars to represent content being loaded.
*@

<div class="skeleton @CssClass">
	@if (Lines > 0)
	{
		@for (int i = 0; i < Lines; i++)
		{
			<div class="skeleton-line" style="@(i == Lines - 1 ? "width: 75%;" : "")"></div>
		}
	}
	else if (ShowCard)
	{
		<div class="skeleton-card">
			<div class="skeleton-line" style="width: 30%;"></div>
			<div class="skeleton-line" style="height: 2rem; margin: 0.5rem 0;"></div>
			<div class="skeleton-line" style="width: 60%;"></div>
		</div>
	}
</div>

@code {
	/// <summary>
	/// Number of lines to display (for text skeleton).
	/// Default is 3. Ignored if ShowCard is true.
	/// </summary>
	[Parameter]
	public int Lines { get; set; } = 3;

	/// <summary>
	/// Whether to show a card-style skeleton (title, large content, subtitle).
	/// When true, Lines parameter is ignored.
	/// </summary>
	[Parameter]
	public bool ShowCard { get; set; }

	/// <summary>
	/// Additional CSS classes to apply.
	/// </summary>
	[Parameter]
	public string CssClass { get; set; } = string.Empty;
}
