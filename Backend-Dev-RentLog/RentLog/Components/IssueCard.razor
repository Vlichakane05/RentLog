@using RentLog.Models

@*
IssueCard component: summary display of an issue.
Shows title, unit, severity, status, time logged, and optional action button.
Not editable; for displaying issue listings.
*@

<div class="issue-card @CssClass">
	<div class="issue-card-header">
		<div class="issue-card-meta">
			<h3 class="issue-title">@Title</h3>
			<p class="issue-unit">Unit @Unit</p>
		</div>
		<div class="issue-card-badges">
			@if (Severity != null)
			{
				<SeverityBadge Severity="@Severity.Value" />
			}
		</div>
	</div>

	<div class="issue-card-row">
		@if (Status != null)
		{
			<StatusBadge Status="@Status.Value" />
		}
		@if (TimeLogged != null)
		{
			<span class="issue-time">
				@TimeLogged.Value.ToString("dd MMM yyyy")
			</span>
		}
	</div>

	@if (ActionButton != null)
	{
		<div class="issue-card-action">
			@ActionButton
		</div>
	}
</div>

@code {
	/// <summary>
	/// Issue title.
	/// </summary>
	[Parameter]
	public string Title { get; set; } = string.Empty;

	/// <summary>
	/// Unit number or identifier.
	/// </summary>
	[Parameter]
	public string Unit { get; set; } = string.Empty;

	/// <summary>
	/// Severity level.
	/// </summary>
	[Parameter]
	public Severity? Severity { get; set; }

	/// <summary>
	/// Current status.
	/// </summary>
	[Parameter]
	public Status? Status { get; set; }

	/// <summary>
	/// When the issue was logged.
	/// </summary>
	[Parameter]
	public DateTime? TimeLogged { get; set; }

	/// <summary>
	/// Optional action button content (Razor component or markup).
	/// </summary>
	[Parameter]
	public RenderFragment? ActionButton { get; set; }

	/// <summary>
	/// Additional CSS classes to apply.
	/// </summary>
	[Parameter]
	public string CssClass { get; set; } = string.Empty;
}
